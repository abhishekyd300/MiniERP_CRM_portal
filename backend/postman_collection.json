{
  "info": {
    "_postman_id": "minicrm-erp-portal-api-collection",
    "name": "Mini ERP + CRM Portal API Collection",
    "description": "Complete Postman collection covering Auth (all 4 roles), Customer CRM, Product Inventory, and Sales Challans endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth Module",
      "item": [
        {
          "name": "Login - Admin Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@minicrm.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - Sales Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@minicrm.com\",\n  \"password\": \"Sales@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - Warehouse Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"warehouse@minicrm.com\",\n  \"password\": \"Warehouse@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - Accounts Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"accounts@minicrm.com\",\n  \"password\": \"Accounts@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Customer CRM Module",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rajesh Kumar\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"rajesh@apexenterprise.com\",\n  \"businessName\": \"Apex Enterprises\",\n  \"gstNumber\": \"07AAAAA0000A1Z5\",\n  \"type\": \"WHOLESALE\",\n  \"address\": \"42 Industrial Area, Phase II, New Delhi\",\n  \"status\": \"LEAD\",\n  \"followUpDate\": \"2026-08-20T10:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "List Customers (Paginated + Filter + Search)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10&search=Apex&status=LEAD",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "Apex" },
                { "key": "status", "value": "LEAD" }
              ]
            }
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":id"],
              "variable": [{ "key": "id", "value": "CUSTOMER_ID_HERE" }]
            }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\",\n  \"address\": \"42 Industrial Area, Updated Location, New Delhi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":id"],
              "variable": [{ "key": "id", "value": "CUSTOMER_ID_HERE" }]
            }
          }
        },
        {
          "name": "Add Follow-up Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Discussed wholesale pricing terms. Client agreed to place trial order next week.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/:id/notes",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":id", "notes"],
              "variable": [{ "key": "id", "value": "CUSTOMER_ID_HERE" }]
            }
          }
        }
      ]
    },
    {
      "name": "Product & Inventory Module",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Industrial Bearing 6205-ZZ\",\n  \"sku\": \"BRG-6205-ZZ\",\n  \"category\": \"Hardware Components\",\n  \"unitPrice\": 450.50,\n  \"currentStock\": 50,\n  \"minStockAlert\": 10,\n  \"location\": \"Rack A-12\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "List Products (Search + Low-Stock Filter)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&search=Bearing&lowStock=false",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "Bearing" },
                { "key": "lowStock", "value": "false" }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"],
              "variable": [{ "key": "id", "value": "PRODUCT_ID_HERE" }]
            }
          }
        },
        {
          "name": "Update Product Metadata",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitPrice\": 475.00,\n  \"minStockAlert\": 15,\n  \"location\": \"Rack A-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"],
              "variable": [{ "key": "id", "value": "PRODUCT_ID_HERE" }]
            }
          }
        },
        {
          "name": "Adjust Stock (IN / OUT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChanged\": 20,\n  \"type\": \"IN\",\n  \"reason\": \"New Shipment Received from Supplier\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/:id/stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id", "stock"],
              "variable": [{ "key": "id", "value": "PRODUCT_ID_HERE" }]
            }
          }
        },
        {
          "name": "Get Stock Movements History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/:id/movements",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id", "movements"],
              "variable": [{ "key": "id", "value": "PRODUCT_ID_HERE" }]
            }
          }
        }
      ]
    },
    {
      "name": "Sales Challan Module",
      "item": [
        {
          "name": "Create Draft Challan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_ID_HERE\",\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID_HERE\",\n      \"quantity\": 5\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "List Challans (Status Filter + Search)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans?page=1&limit=10&status=DRAFT",
              "host": ["{{baseUrl}}"],
              "path": ["challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "DRAFT" }
              ]
            }
          }
        },
        {
          "name": "Get Challan by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id"],
              "variable": [{ "key": "id", "value": "CHALLAN_ID_HERE" }]
            }
          }
        },
        {
          "name": "Edit Draft Challan",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID_HERE\",\n      \"quantity\": 8\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans/:id",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id"],
              "variable": [{ "key": "id", "value": "CHALLAN_ID_HERE" }]
            }
          }
        },
        {
          "name": "Confirm Challan (Atomic Stock Deduction)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "confirm"],
              "variable": [{ "key": "id", "value": "CHALLAN_ID_HERE" }]
            }
          }
        },
        {
          "name": "Cancel Challan (Restores Stock if Confirmed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "cancel"],
              "variable": [{ "key": "id", "value": "CHALLAN_ID_HERE" }]
            }
          }
        }
      ]
    }
  ]
}
